# Пароль в админку (/admin). Обязателен.
ADMIN_PASSWORD=

# Куда пересылать заявки: любой вебхук, принимающий JSON (Telegram-бот, CRM, Make)
LEADS_WEBHOOK_URL=

# Дублировать заявки в файл, чтобы видеть их в админке на /admin/leads
LEADS_SAVE_LOCAL=1

# --- Данные, которые правит админка ---
# На сервере эти каталоги ОБЯЗАТЕЛЬНО должны лежать вне папки приложения,
# иначе редеплой из гита сотрёт тексты, фото и презентацию.
# Локально можно не задавать: по умолчанию content/ и var/ внутри проекта.
CONTENT_DIR=
UPLOADS_DIR=
DATA_DIR=
