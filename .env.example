# Пароль для первого входа в админку (/admin).
# Дальше пароль меняется в самой админке и хранится на сервере.
ADMIN_PASSWORD=

# --- Куда уходят заявки ---

# Telegram: токен бота от @BotFather и id группы, куда он добавлен
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Почта: SMTP ящика, с которого отправляются письма
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
LEADS_EMAIL_TO=egorova@kims.com.ua

# Дублировать заявки в файл, чтобы видеть их в админке
LEADS_SAVE_LOCAL=1

# Необязательно: дополнительный вебхук (CRM, Make и т.п.)
LEADS_WEBHOOK_URL=

# --- Прочее ---

# Google Analytics (подключается только после согласия на cookie)
NEXT_PUBLIC_GA_ID=

# Каталоги данных админки. По умолчанию $HOME/kims-data — задавать нужно,
# только если это место не подходит
CONTENT_DIR=
UPLOADS_DIR=
DATA_DIR=

# Адрес сайта и запрет индексации — обычно задаются в самой админке.
# SITE_NOINDEX=1 закрывает домен принудительно (технический сайт)
SITE_URL=
SITE_NOINDEX=
